<!DOCTYPE html>
<html>
  <head>
    <title>DungeonArena</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag 'dungeon_favicon' %>
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.5.2/css/all.css">
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.5.2/css/sharp-thin.css">
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.5.2/css/sharp-solid.css">
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.5.2/css/sharp-regular.css">
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.5.2/css/sharp-light.css">
  </head>
  <body class="bg-zinc-900 text-white">
    <header class="bg-zinc-900 sticky top-0 z-50 border-b border-zinc-800">
      <div class="flex items-center justify-between p-3">
        <div class="flex items-center gap-2">
          <button id="open-sidebar-mobile" class="sm:hidden bg-neutral-900 text-white p-2 rounded-lg" aria-label="Open menu">
            <i class="fas fa-bars"></i>
          </button>
          <a href="<%= root_path %>" class="flex items-center">
            <%= image_tag "logo2.svg", class:"h-10" %>
          </a>
        </div>
        <div class="flex items-center gap-2">
          <% if user_signed_in? %>
            <%= link_to edit_user_registration_path do %>
              <%= image_tag(current_user.avatar_thumbnail, class:"rounded-full size-8 border-2 border-gray-300") %>
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class:"px-3 py-1 rounded bg-zinc-800" do %>
              Login
            <% end %>
          <% end %>
        </div>
      </div>
    </header>
    <div class="min-h-screen flex flex-col">
      <%= render "layouts/aside" %>
      <main class="flex-1 flex flex-col bg-zinc-800">
        <div class="p-4 space-y-4 flex-1">
          <p class="notice"><%= notice %></p>
          <p class="alert"><%= alert %></p>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
