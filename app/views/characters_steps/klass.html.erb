<%= render "characters_steps/step_form",
           character: @character,
           url: wizard_path(:klass, character_id: @character.id),
           title: "Step 1: Choose Your Class",
           description: -> {
             safe_join([
               "Select a class for your character. Each class offers unique abilities and traits.",
               tag.br,
               "Click on the ",
               tag.i(class: "fa-solid fa-circle-info fa-sm"),
               " icon to view more details about the class and its features."
             ])
           },
           previous_path: wizard_path(:klass, character_id: @character.id),
           form_options: { data: { turbo: false } } do |f| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
    <% @klasses.each do |klass| %>
      <% option_id = dom_id(klass, :option) %>
      <div class="relative">
        <%= f.radio_button :klass_id,
                            klass.name,
                            id: option_id,
                            class: "sr-only peer",
                            data: { action: "change->char-visualizer#changeClass" } %>
        <label for="<%= option_id %>"
               class="block h-full border border-white/10 bg-neutral-800/70 rounded-xl p-4 shadow transition hover:border-amber-500 hover:bg-amber-500/10 peer-checked:border-amber-500 peer-checked:bg-gradient-to-r peer-checked:from-amber-400 peer-checked:via-amber-500 peer-checked:to-amber-600">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <%= image_tag "icons/#{klass.name.downcase}.png", class: "size-10" %>
              <div>
                <p class="text-base font-semibold"><%= klass.name %></p>
                <p class="text-xs text-gray-300">Primary role · <%= klass.hit_dice %> Hit Dice</p>
              </div>
            </div>
            <%= link_to klass_modal_path(klass_id: klass.id),
                        data: { turbo_frame: "modal" },
                        class: "text-amber-300 hover:text-amber-200 transition" do %>
              <i class="fa-solid fa-circle-info fa-lg"></i>
            <% end %>
          </div>
        </label>
      </div>
    <% end %>
  </div>

  <div class="space-y-2">
    <label for="character_name" class="text-sm font-semibold text-gray-200">Character Name</label>
    <%= f.text_field :name,
                     class: "w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-base text-white placeholder:text-gray-400 focus:border-amber-400 focus:ring focus:ring-amber-400/40",
                     required: true,
                     data: { action: "change->char-visualizer#changeName" } %>
  </div>
<% end %>
