<%= render "characters_steps/step_form",
           character: @character,
           url: wizard_path(:personality, character_id: @character.id),
           method: :put,
           title: "Step 6: Personality",
           description: "Round out your hero with defining quirks, values, and flaws to guide their decisions.",
           previous_path: wizard_path(:notes, character_id: @character.id),
           next_label: "Finish",
           next_button_options: { class: "bg-amber-500 hover:bg-amber-600 focus-visible:outline-amber-300" } do |f| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% {
         personality: "Personality Traits",
         ideals: "Ideals",
         bonds: "Bonds",
         flaws: "Flaws"
       }.each do |attribute, label| %>
      <div class="space-y-2">
        <%= f.label attribute, label, class: "text-sm font-semibold text-gray-200" %>
        <%= f.text_area attribute,
                        rows: 3,
                        class: "w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white placeholder:text-gray-400 focus:border-amber-400 focus:ring focus:ring-amber-400/40" %>
      </div>
    <% end %>
  </div>
<% end %>
