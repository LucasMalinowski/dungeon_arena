<% token_url = @character.token.attached? ? url_for(@character.token) : asset_path(@character.token_thumbnail) %>

<div class="relative w-full overflow-hidden rounded-3xl border-8 border-neutral-900 bg-neutral-950 text-white shadow-2xl"
     style="background-image: url('<%= asset_path("wood.png") %>'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-neutral-900/40"></div>

  <div class="relative space-y-4 p-6">
    <div class="flex items-center justify-center">
      <div class="relative h-16 w-48">
        <div class="absolute inset-0 rotate-2 rounded-xl bg-amber-200/80 shadow"></div>
        <div class="absolute inset-0 -rotate-1 rounded-xl bg-amber-100/80 shadow-inner"></div>
        <p class="relative z-10 flex h-full items-center justify-center text-xl font-bold text-neutral-900">Character Preview</p>
      </div>
    </div>

    <div class="space-y-4 rounded-2xl border border-neutral-900/60 bg-amber-50/90 p-4 text-neutral-900 shadow-xl"
         style="background-image: url('<%= asset_path("wood.png") %>'); background-size: cover; background-position: center;">
      <div class="group relative flex h-72 w-full items-center justify-center overflow-hidden rounded-xl border-4 border-neutral-800 bg-amber-100/70 bg-contain bg-center bg-no-repeat"
           data-char-visualizer-target="imageDisplay"
           data-image-url="<%= token_url %>"
           style="background-image: url('<%= token_url %>');">
        <div class="pointer-events-none absolute inset-0 bg-neutral-950/40 opacity-0 transition-opacity group-hover:opacity-100"></div>

        <% if @character.token.attached? %>
          <%= form_with model: @character,
                        url: remove_token_character_path(@character),
                        method: :delete,
                        data: { turbo: false },
                        html: { class: "absolute top-3 right-3 opacity-0 transition-opacity group-hover:opacity-100" } do |f| %>
            <%= f.hidden_field :step, value: @current_step %>
            <button type="submit" class="flex size-10 items-center justify-center rounded-full bg-red-500 text-white shadow hover:bg-red-600">
              <i class="fas fa-trash-alt"></i>
            </button>
          <% end %>
        <% end %>

        <%= form_with model: @character,
                      url: character_path(@character),
                      method: :patch,
                      data: { turbo_frame: "_top", char_visualizer_target: "tokenForm" },
                      html: { class: "absolute inset-0 flex items-center justify-center" } do |f| %>
          <%= f.file_field :token,
                           class: "hidden",
                           direct_upload: true,
                           id: "character_token",
                           data: { action: "change->char-visualizer#submitToken", char_visualizer_target: "tokenInput" } %>
          <label for="character_token" class="relative z-10 flex cursor-pointer items-center justify-center rounded-full bg-amber-100/90 p-3 text-neutral-900 shadow-lg opacity-0 transition-opacity group-hover:opacity-100">
            <i class="fas fa-pen"></i>
          </label>
        <% end %>
      </div>

      <div class="text-center">
        <p class="text-xl font-semibold text-neutral-900" data-char-visualizer-target="nameDisplay">
          <%= @character.name.presence || "Unnamed Hero" %>
        </p>
        <p class="text-sm text-neutral-700">
          Level <span data-char-visualizer-target="levelDisplay"><%= @character.level || 0 %></span>
        </p>
        <p class="text-sm text-neutral-700">
          <span data-char-visualizer-target="classDisplay"><%= @character.klass&.name.presence || "-------" %></span>
          /
          <span data-char-visualizer-target="raceDisplay"><%= @character.race&.name.presence || "--------" %></span>
        </p>
      </div>

      <div class="rounded-xl border border-neutral-900/40 bg-neutral-800/90 p-3 text-amber-50 shadow">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-neutral-300">Attributes</p>
        <div class="grid grid-cols-3 gap-2 text-center text-sm font-semibold sm:grid-cols-6">
          <% @character.character_attribute_names.each do |label, method_name| %>
            <div class="rounded-lg border border-neutral-700 bg-neutral-900/80 p-3">
              <span class="block text-xs text-neutral-400"><%= label %></span>
              <span class="text-lg" data-char-visualizer-target="<%= method_name %>Display">
                <%= @character.ability_scores&.send(method_name) || "--" %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
