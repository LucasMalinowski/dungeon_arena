<div class="relative w-full text-white" style="background-color: #230e01;">
  <div class="relative border-8 border-neutral-900 rounded-xl p-6" style="background-image:url('<%= asset_path("wood.png") %>'); background-size: cover; background-repeat: no-repeat; background-position: center;">
    <div class="absolute -top-6 left-1/2 -translate-x-1/2">
      <div class="relative w-64 h-14">
        <div class="absolute w-full h-12 top-1/2 -translate-y-1/2 bg-amber-50 rounded-lg transform rotate-1"></div>
        <div class="absolute left-0 w-8 h-full bg-amber-50 rounded-l-lg transform -rotate-12"></div>
        <div class="absolute right-0 w-8 h-full bg-amber-50 rounded-r-lg transform rotate-12"></div>
        <h2 class="absolute w-full text-center top-1/2 -translate-y-1/2 text-2xl font-bold text-neutral-900">
          Character Preview
        </h2>
      </div>
    </div>

    <div class="bg-amber-50/90 rounded-lg p-6 space-y-3" style="background-image:url('<%= asset_path("wood.png") %>'); background-size: cover; background-repeat: no-repeat; background-position: center;">
      <div class="relative group w-full h-80 rounded-xl border-4 border-neutral-800 overflow-hidden shadow-[0_0_40px_rgba(0,0,0,0.45)]"
           style="background-image: linear-gradient(180deg, rgba(15,23,42,0.65) 0%, rgba(12,10,9,0.9) 100%), url('<%= @character.token.attached? ? url_for(@character.token) : asset_path(@character.token_thumbnail) %>')"
           data-char-visualizer-target="imageDisplay">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/20 to-black/60 pointer-events-none"></div>

        <div class="relative w-full h-full" data-char-visualizer-target="viewport"></div>

        <div class="absolute top-3 right-3 flex flex-col gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
          <%= form_with model: @character, url: remove_token_character_path(@character), method: :delete, data: { turbo: false }, html: { class: "pointer-events-auto" } do |f| %>
            <%= f.text_field :step, class: "hidden", value: @current_step %>
            <button type="submit" class="flex items-center justify-center w-10 h-10 bg-red-600/90 text-white rounded-full shadow-lg hover:bg-red-500 transition">
              <i class="fas fa-trash-alt"></i>
            </button>
          <% end %>

          <%= form_with model: @character, url: character_path(@character), method: :patch, html: { class: "pointer-events-auto" } do |f| %>
            <%= f.file_field :token, class: "hidden", direct_upload: true, id: "character_token", data: { action: "change->char-visualizer#uploadToken", char_visualizer_target: "tokenInput" } %>
            <label for="character_token" class="flex items-center justify-center w-10 h-10 bg-amber-400/90 text-neutral-900 rounded-full shadow-lg hover:bg-amber-300 transition cursor-pointer">
              <i class="fas fa-image"></i>
            </label>
          <% end %>
        </div>
      </div>

      <div class="text-center space-y-2">
        <div class="text-xl font-bold text-neutral-900 space-y-1">
          <div>
            <span data-char-visualizer-target="nameDisplay"><%= @character.name.presence || "Unnamed Hero" %></span>
            <span data-char-visualizer-target="levelDisplay" class="text-sm">(<%= @character.level || 0 %>)</span>
          </div>
          <div class="text-sm">
            <span data-char-visualizer-target="classDisplay"><%= @character.klass&.name.presence || "-------" %></span>
            /
            <span data-char-visualizer-target="raceDisplay"><%= @character.race&.name.presence || "--------" %></span>
          </div>
        </div>
      </div>

      <div class="flex justify-between mt-2">
        <div class="flex-1 bg-neutral-800 rounded-lg p-2 shadow-md text-center border border-neutral-900">
          <span class="block text-sm text-neutral-400 mb-2">Attributes</span>
          <div class="flex w-full text-xl font-bold text-amber-50 gap-2 justify-between">
            <% @character.character_attribute_names.each do |attr| %>
              <div class="flex flex-col bg-neutral-800 rounded-lg p-3 max-w-20 shadow-md text-center border border-neutral-900">
                <%= attr[0].to_s %>
                <%= @character.ability_scores&.send("#{attr[1]}") || "--" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute -top-4 -left-4 w-8 h-8 bg-neutral-800 rounded-full border-4 border-neutral-900"></div>
    <div class="absolute -top-4 -right-4 w-8 h-8 bg-neutral-800 rounded-full border-4 border-neutral-900"></div>
    <div class="absolute -bottom-4 -left-4 w-8 h-8 bg-neutral-800 rounded-full border-4 border-neutral-900"></div>
    <div class="absolute -bottom-4 -right-4 w-8 h-8 bg-neutral-800 rounded-full border-4 border-neutral-900"></div>
  </div>
</div>
