<% abilities = %w[Strength Dexterity Constitution Intelligence Wisdom Charisma] %>
<% scores = [15, 14, 13, 12, 10, 8] %>
<% racial_bonuses = Hash.new(0) %>
<% if @character.race.present? %>
  <% @character.race_ability_bonus.each do |bonus| %>
    <% ability_key = bonus.ability_score.name.downcase %>
    <% racial_bonuses[ability_key] += bonus.bonus.to_i %>
  <% end %>
<% end %>
<% if @character.subrace.present? %>
  <% @character.subrace.subrace_ability_bonus.each do |bonus| %>
    <% ability_key = bonus.ability_score.name.downcase %>
    <% racial_bonuses[ability_key] += bonus.bonus.to_i %>
  <% end %>
<% end %>

<%= render "characters_steps/step_form",
           character: @character,
           url: wizard_path(:abilities, character_id: @character.id),
           title: "Step 3: Assign Abilities",
           description: "Distribute your ability scores. Each score can be used once, and racial bonuses are applied automatically.",
           previous_path: wizard_path(:species, character_id: @character.id) do |f| %>
  <div class="space-y-6" data-controller="abilities">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-neutral-800/80 rounded-xl p-4 shadow-inner">
      <% abilities.each do |ability| %>
        <% ability_key = ability.downcase %>
        <div class="space-y-2">
          <label for="character_abilities_<%= ability_key %>" class="block text-sm font-semibold text-gray-200"><%= ability %></label>
          <%= select_tag "character[abilities][#{ability}]",
                         options_for_select([["--", nil]] + scores.map { |score| [score, score] }),
                         include_blank: false,
                         id: "character_abilities_#{ability_key}",
                         class: "w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white focus:border-amber-400 focus:ring focus:ring-amber-400/40",
                         data: { action: "change->abilities#handleChange", ability_name: ability_key, abilities_target: "select" } %>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% abilities.each do |ability| %>
        <% ability_key = ability.downcase %>
        <% racial_bonus = racial_bonuses.fetch(ability_key, 0) %>
        <div class="rounded-xl border border-white/10 bg-neutral-900/70 p-4 text-sm text-gray-200 shadow" data-abilities-target="display" data-ability="<%= ability_key %>" data-bonus="<%= racial_bonus %>">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-semibold text-white"><%= ability %></h3>
            <span class="text-xs text-amber-300">Racial Bonus: <span data-role="bonus"><%= racial_bonus.positive? ? "+#{racial_bonus}" : racial_bonus %></span></span>
          </div>
          <dl class="mt-3 space-y-1">
            <div class="flex justify-between text-xs">
              <dt class="text-gray-400">Base Score</dt>
              <dd class="font-semibold text-white" data-role="base">--</dd>
            </div>
            <div class="flex justify-between text-xs">
              <dt class="text-gray-400">Total Score</dt>
              <dd class="font-semibold text-white" data-role="total">--</dd>
            </div>
            <div class="flex justify-between text-xs">
              <dt class="text-gray-400">Modifier</dt>
              <dd class="font-semibold text-white" data-role="modifier">--</dd>
            </div>
          </dl>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
