<%= render "characters_steps/step_form",
           character: @character,
           url: wizard_path(:species, character_id: @character.id),
           title: "Step 2: Choose Your Species",
           description: -> {
             safe_join([
               "Select a species for your character. Each one provides unique traits and bonuses.",
               tag.br,
               "Click on the ",
               tag.i(class: "fa-solid fa-circle-info fa-sm"),
               " icon to read more about a species or sub-species before locking it in."
             ])
           },
           previous_path: wizard_path(:klass, character_id: @character.id) do |f| %>
  <div class="space-y-5" data-controller="species">
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
      <% @races.each do |race| %>
        <% race_option_id = dom_id(race, :option) %>
        <div class="space-y-2" data-controller="collapse">
          <%= f.radio_button :race_id,
                              race.name,
                              id: race_option_id,
                              class: "sr-only peer",
                              data: { species_target: "radio", action: "click->species#toggleRadio change->char-visualizer#changeRace" } %>

          <label for="<%= race_option_id %>"
                 class="block border border-white/10 bg-neutral-800/70 rounded-xl p-4 shadow transition hover:border-amber-500 hover:bg-amber-500/10 peer-checked:border-amber-500 peer-checked:bg-gradient-to-r peer-checked:from-amber-400 peer-checked:via-amber-500 peer-checked:to-amber-600">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <% if race.subraces.any? %>
                  <button type="button"
                          class="text-gray-300 transition-transform duration-200"
                          data-action="click->collapse#toggle">
                    <i class="fa-solid fa-chevron-down" data-collapse-target="icon"></i>
                  </button>
                <% end %>
                <div>
                  <p class="text-base font-semibold"><%= race.name %></p>
                  <% if race.speed.present? %>
                    <p class="text-xs text-gray-300">Speed · <%= race.speed %> ft</p>
                  <% end %>
                </div>
              </div>
              <%= link_to race_modal_path(race_id: race.id),
                          data: { turbo_frame: "modal" },
                          class: "text-amber-300 hover:text-amber-200 transition" do %>
                <i class="fa-solid fa-circle-info fa-lg"></i>
              <% end %>
            </div>
          </label>

          <% if race.subraces.any? %>
            <div class="hidden space-y-2 pl-8" data-collapse-target="panel">
              <% race.subraces.each do |subrace| %>
                <% subrace_option_id = dom_id(subrace, :option) %>
                <div class="border border-white/10 bg-neutral-900/80 rounded-xl p-3">
                  <%= radio_button_tag "character[subrace_id]",
                                       subrace.name,
                                       false,
                                       id: subrace_option_id,
                                       class: "sr-only peer",
                                       data: { species_target: "radio", action: "click->species#toggleRadio" } %>
                  <label for="<%= subrace_option_id %>"
                         class="flex items-center justify-between gap-2 rounded-lg border border-transparent px-3 py-2 text-sm font-medium text-gray-200 transition hover:border-amber-500 hover:bg-amber-500/10 peer-checked:border-amber-500 peer-checked:bg-amber-500/10">
                    <span class="flex items-center gap-2">
                      <i class="fa-solid fa-feather text-blue-300"></i>
                      <%= subrace.name %>
                    </span>
                    <%= link_to race_modal_path(subrace_id: subrace.id),
                                data: { turbo_frame: "modal" },
                                class: "text-amber-300 hover:text-amber-200 transition" do %>
                      <i class="fa-solid fa-circle-info"></i>
                    <% end %>
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
